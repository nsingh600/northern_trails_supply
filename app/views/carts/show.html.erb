<div class="container my-4"><h1 class="mb-3">Shopping Cart</h1><% if @cart_items.any? %><table class="table table-bordered align-middle"><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr></thead><tbody><% @cart_items.each do |row| %><tr><td><%= link_to row[:product].name, product_path(row[:product]) %></td><td><%= number_to_currency(row[:product].price) %></td><td><%= form_with url: cart_item_path(row[:product].id), method: :patch, local: true, class: "d-flex gap-2" do |f| %><%= f.number_field :quantity, value: row[:quantity], min: 0, class: "form-control form-control-sm", style: "width: 80px;" %><%= f.submit "Update", class: "btn btn-sm btn-outline-primary" %><% end %></td><td><%= number_to_currency(row[:line_total]) %></td><td><%= button_to "Remove", cart_item_path(row[:product].id), method: :delete, class: "btn btn-sm btn-outline-danger" %></td></tr><% end %></tbody></table><div class="d-flex justify-content-between align-items-center mt-3"><h4>Subtotal: <%= number_to_currency(@subtotal) %></h4><%= link_to "Continue Shopping", products_path, class: "btn btn-secondary" %> <%= link_to "Proceed to Checkout", new_order_path, class: "btn btn-success" %></div><% else %><p>Your cart is currently empty.</p><%= link_to "Browse Products", products_path, class: "btn btn-primary" %><% end %></div>
