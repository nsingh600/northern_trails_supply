<!DOCTYPE html>
<html lang="en">
  <head>
    <%= link_to "Northern Trails Supply", root_path, class: "navbar-brand fw-bold text-white" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-light d-flex flex-column min-vh-100">
    <%= render "shared/navbar" %>

    <main class="container my-4 flex-grow-1">
      <% flash.each do |type, message| %>
        <% alert_class = type == "alert" ? "alert-danger" : "alert-success" %>
        <div class="alert <%= alert_class %> alert-dismissible fade show" role="alert">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <p class="mb-1 mb-md-0">&copy; <%= Time.current.year %> Northern Trails Supply Co. — Winnipeg, Manitoba</p>
        <small class="text-secondary">Outfitting Canadian adventures since 2009</small>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>