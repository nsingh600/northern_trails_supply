<div class="container my-4">
  <h1>My Orders</h1>
  <% if @orders.any? %>
    <table class="table table-striped">
      <thead><tr><th>Order #</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
      <tbody><% @orders.each do |o| %><tr><td>#<%= o.id %></td><td><%= o.created_at.strftime("%Y-%m-%d") %></td><td><%= o.status.capitalize %></td><td><%= number_to_currency(o.total) %></td><td><%= link_to "View Invoice", order_path(o), class: "btn btn-sm btn-outline-primary" %></td></tr><% end %></tbody>
    </table>
  <% else %>
    <p>You have not placed any orders yet.</p>
  <% end %>
</div>
